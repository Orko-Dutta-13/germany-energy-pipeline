# ── Airflow ───────────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here

# ── Postgres (Airflow metadata + raw data) ────────────────────
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Raw data DB (same Postgres, different schema) ─────────────
RAW_DB_SCHEMA=raw_energy

# ── DuckDB ────────────────────────────────────────────────────
DUCKDB_PATH=/opt/airflow/data/energy.duckdb

# ── SMARD API (no key needed — public) ───────────────────────
SMARD_BASE_URL=https://www.smard.de/app/chart_data

# ── ENTSO-E (swap in when you get a key) ─────────────────────
# ENTSOE_API_KEY=your_api_key_here
